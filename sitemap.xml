---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Main Pages & Neighborhood Indexes -->
  {% for page in site.pages %}
    {% if page.url and page.sitemap != false and page.url !="/404.html" %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
      <lastmod>{{ page.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
      <changefreq>{% if page.url == "/" %}daily{% else %}weekly{% endif %}</changefreq>
      <priority>{% if page.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
    </url>
    {% endif %}
  {% endfor %}

  <!-- Blog Posts & Intelligence Hub Content -->
  {% for post in site.posts %}
    {% if post.sitemap != false %}
    <url>
      <loc>{{ site.url }}{{ post.url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
    </url>
    {% endif %}
  {% endfor %}
</urlset>
